AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
AZURE_OPENAI_API_KEY=

# Connect via Azure's built-in PgBouncer (port 6432, transaction pooling mode)
DATABASE_URL="postgresql://AZURE_POSTGRES_USER:AZURE_POSTGRES_PASSWORD@AZURE_POSTGRES_HOST:6432/postgres?sslmode=verify-full"

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_FROM=
SMTP_PASS=

AUTH_SECRET=

# Sentry: browser feedback and browser/server error reporting
NEXT_PUBLIC_SENTRY_DSN=
# Optional server DSN override; defaults to NEXT_PUBLIC_SENTRY_DSN
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Optional source map uploads during production builds
SENTRY_ORG=eosg-dev
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Umami: use this app's website ID, not the mandate registry's
NEXT_PUBLIC_UMAMI_WEBSITE_ID=491ec3b3-b18b-41d5-8b69-56dce034a580
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_DOMAINS=
